# Reference only: set variables in cPanel; this file is NOT loaded automatically.
# Never commit passwords, database files or real financial documents.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LANDUR_DEMO=0
# Replace the origin with your dedicated LANDUR subdomain (no trailing slash).
LANDUR_PUBLIC_ORIGIN=https://landur.example.com
# Replace this with the real cPanel home path, outside public_html and code.
LANDUR_DATA_DIR=/home/CPANEL_ACCOUNT/landur-private/data
LANDUR_BACKUP_DIR=/home/CPANEL_ACCOUNT/landur-backups
# Set LANDUR_PASSWORD to a unique secret of 16–256 characters in cPanel, not Git.
# Local synthetic demo: unset NODE_ENV, LANDUR_PUBLIC_ORIGIN and LANDUR_DATA_DIR;
# then LANDUR_DEMO=1 LANDUR_INSECURE_LOCAL=1 npm start (HTTP localhost only).
