  "version": "1.0.0",
  "type": "module",
  "description": "Rivect Retail Intelligence — demo comercial interactiva B2B",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:portal": "tsc --noEmit && vite build --config vite.config.portal.ts && node scripts/publish-portal.mjs",
